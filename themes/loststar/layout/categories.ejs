<div id="archives">
    <% let posts = []; %>
    <%
        const getDisplayTitle = (post) => {
            const catName = post.categories && post.categories.data.length > 0 ? post.categories.data[0].name : null;
            return catName === 'Diary' ? date(post.date, 'DD/MM/YYYY') : post.title;
        };
    %>
    <%- partial("_partial/page-heading") %>
    <div class="categories-tags">
        <% site.categories.forEach((category) => { %>
        <%
            const catStyle = getTxCategoryStyle(category.name);
            const isActive = is_category(category.name);
            /* 深浅两套配色都写进 CSS 变量，由 custom.css 按主题选一套。
               内联 background/color 不会跟着 [data-theme] 变，
               所以深色模式下会一直是浅色底 —— 详见 tags.ejs 里的同类注释。 */
            const chipBase = catStyle ? catStyle.bg : '#eef2f7';
            const chipDark = catStyle ? catStyle.dBg : '#26313d';
            const chipBg = isActive
                ? `linear-gradient(120deg, ${chipBase} 0%, ${chipBase} 60%)`
                : chipBase;
            const chipBgDark = isActive
                ? `linear-gradient(120deg, ${chipDark} 0%, ${chipDark} 60%)`
                : chipDark;
            const chipText = catStyle ? catStyle.text : '#4f6370';
            const chipTextDark = catStyle ? catStyle.dText : '#b6c2d0';
        %>
        <span>
            <a href="<%- url_for(category.path) %>" class="tx-chip<% if (isActive) { %> active-chip<% } %>" style="--tx-bg: <%- chipBg %>; --tx-fg: <%- chipText %>; --tx-dbg: <%- chipBgDark %>; --tx-dfg: <%- chipTextDark %>">
                <span class="icon">
                    <i class="fa-solid fa-bookmark fa-fw"></i>
                </span>
                <%= category.name %>
            </a>
        </span>
        <% if (isActive) { %>
        <%
            posts = category.posts;
            posts.data.sort((a, b) => b.date - a.date);
        %>
        <% } %>
        <% }); %>
    </div>
    <% posts.forEach((post) => { %>
    <%
        const postCatName = post.categories && post.categories.data.length > 0 ? post.categories.data[0].name : null;
    %>
    <div class="timeline">
        <div class="timeline-tail"></div>
        <div class="timeline-content">
            <div class="item-time"><%= date(post.date, "YYYY/M/D") %></div>
            <a href="<%- url_for(post.path) %>">
                <%# 原来是 h3，与页面标题 h1 之间缺一级。改 h2，字号见 custom.css %>
                <h2><%= getDisplayTitle(post) %></h2>
            </a>
            <div class="info">
                <% if (post.categories && post.categories.data.length !== 0) { %>
                <%
                    const pCatStyle = getTxCategoryStyle(post.categories.data[0].name);
                %>
                <span class="category">
                    <a href="<%- url_for(post.categories.data[0].path) %>"<% if (pCatStyle) { %> style="color:<%- pCatStyle.text %>"<% } %>>
                        <span class="icon">
                            <i class="fa-solid fa-bookmark fa-fw"></i>
                        </span>
                        <%= post.categories.data[0].name %>
                    </a>
                </span>
                <% } %>
                <% if (post.tags && post.tags.data.length !== 0) { %>
                <span class="tags">
                    <span class="icon">
                        <i class="fa-solid fa-tags fa-fw"></i>
                    </span>
                    <% post.tags.data.forEach((tag) => { %>
                    <%
                        const tagStyle = getTxTagStyle(tag.name, postCatName);
                    %>
                    <span class="tag">
                        <a href="<%- url_for(tag.path) %>"<% if (tagStyle) { %> style="color:<%- tagStyle.text %>"<% } %>>
                            <%= tag.name %>
                        </a>
                    </span>
                    <% }); %>
                </span>
                <% } %>
            </div>
        </div>
    </div>
    <% }); %>
</div>
