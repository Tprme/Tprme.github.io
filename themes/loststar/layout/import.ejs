<%#
  资源全部本地自托管，不再依赖 cdnjs / Google Fonts。
  原因：这两家在国内网络下不稳定甚至不可达，
  Vue 加载失败会让页面永远停在「加载中」，Font Awesome 失败则所有图标消失。
  本地文件见 themes/loststar/source/js/lib/ 与 source/css/fontawesome/。

  自托管资源一律用 asset_url 而不是 url_for：它会拼上文件内容的短 hash，
  避免 GitHub Pages 的 max-age=600 造成「新 HTML 配旧 CSS」。
  详见 scripts/asset-version.js。
%>
<link rel="stylesheet" href="<%- asset_url("/css/fontawesome/css/all.min.css") %>" />
<script src="<%- asset_url("/js/lib/vue.min.js") %>"></script>
<script> const mixins = {}; </script>
<% if (theme.polyfill.enable) { %>
<script src="https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=<%- theme.polyfill.features %>"></script>
<% } %>
<%#
  代码高亮相关资源只在「这一页真的有代码块」时才加载。
  highlight.min.js 一个文件就 146 KB，而首页 / 归档 / 分类 / 标签 / 关于 /
  404 都没有代码块 —— 实测每页白下 150 KB 左右。
  page.content 是渲染后的正文 HTML，用有没有 <pre 来判断最直接；
  归档这类列表页没有 page.content，所以要判空。
  注意：本站代码块是服务端高亮的，但没有代码块时这些资源（含行号样式、
  复制按钮脚本）本来就没有作用对象，所以按页跳过是安全的。
%>
<% var lyHasCode = typeof page !== "undefined" && page.content && /<pre[\s>]/.test(page.content); %>
<% if (theme.highlight.enable && lyHasCode) { %>
<script src="<%- asset_url("/js/lib/highlight.min.js") %>"></script>
<script src="<%- asset_url("/js/lib/highlightjs-line-numbers.js") %>"></script>
<link rel="stylesheet" href="<%- asset_url("/css/hljs-github.min.css") %>" />
<script src="<%- asset_url("/js/lib/highlight.js") %>"></script>
<% } %>
<% if (theme.math.enable) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css" />
<script src="<%- asset_url("/js/lib/math.js") %>"></script>
<% } %>
<% if (theme.preview.enable) { %>
<script src="<%- asset_url("/js/lib/preview.js") %>"></script>
<% } %>
<% if (theme.crypto.enable && typeof page.secret !== "undefined") { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.2.0/crypto-js.min.js"></script>
<script src="<%- asset_url("/js/lib/crypto.js") %>"></script>
<% } %>
<% if (type === "archives" && theme.search.enable) { %>
<script src="<%- asset_url("/js/lib/search.js") %>"></script>
<% } %>
<% if (type === "post" && page.comments) { %>
<% if (theme.gitalk.enable) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gitalk/1.8.0/gitalk.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/gitalk/1.8.0/gitalk.min.css" />
<% } %>
<% if (theme.waline.enable) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/waline/3.3.2/waline.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/waline/3.3.2/waline.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/waline/3.3.2/waline-meta.min.css" />
<% } %>
<% if (theme.twikoo.enable) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twikoo/1.6.31/twikoo.all.min.js"></script>
<% } %>
<% } %>
<% if (type === "index") { %>
<script src="<%- asset_url("/js/lib/home.js") %>"></script>
<% } %>
<% if (theme.stars && theme.stars.enable) { %>
<script src="<%- asset_url("/js/lib/stars.js") %>"></script>
<% } %>
<link rel="stylesheet" href="<%- asset_url("/css/main.css") %>" />
<!-- 把首页背景图路径暴露给 CSS，用于首屏的模糊衬底 -->
<style>
    :root {
        --ly-bg-image: url("<%- url_for(theme.background[0]) %>");
    }
</style>
<!-- 本站自定义配色覆盖，必须放在 main.css 之后 -->
<link rel="stylesheet" href="<%- asset_url("/css/custom.css") %>" />
