<div id="home-head">
    <div
        id="home-background"
        ref="homeBackground"
        data-images="<%- theme.background.map(url_for) %>"
    ></div>
    <%# 首屏照片。用真实 <img> 而不是 background-image，
        这样它可以固定占视口宽度的一部分，边缘羽化(mask)才能稳定地落在照片上，
        不会随窗口尺寸变化而错位。 %>
    <img id="home-photo" src="<%- url_for(theme.background[0]) %>" alt="" aria-hidden="true" />
    <%# 首屏柔光纹理：浅色模式下的一层极淡弥散色斑。
        用独立元素而不是 ::after —— ::after 已用于面板底色与深色星空。
        z-index 1，低于照片(2)和正文(3)，所以不会盖住内容。 %>
    <div class="ly-hero-texture" aria-hidden="true"></div>
    <%# 流星层：只在深色模式的星空上出现（浅色模式整体隐藏，见 custom.css）。
        每条流星 = 一个划过的小白点 + 一条它留下的尾迹，两层各自独立动画：
          - .ly-meteor-dot    小亮点，约 0.6s 从左上掠到右下后消失；
          - .ly-meteor-trail  尾迹，随点前进由 0 伸长，点消失后仍留在
                              星空上停留片刻才淡去（像飞机拉出的白线）。
        之所以拆两层：点要「移动」，尾迹要「伸长 + 延后淡出」，
        位移与缩放是两套不同的动画，合在一个元素里做不到。 %>
    <div class="ly-meteor-field" aria-hidden="true">
        <span class="ly-meteor"><i class="ly-meteor-trail"></i><i class="ly-meteor-dot"></i></span>
        <span class="ly-meteor"><i class="ly-meteor-trail"></i><i class="ly-meteor-dot"></i></span>
    </div>
    <div id="home-info" @click="homeClick">
        <span class="loop"></span>
        <span class="loop"></span>
        <span class="loop"></span>

        <span class="info">
            <div class="wrap">
                <h1><%= config.title %></h1>
                <%# 副标题原来是 <h3>，会造成 h1 → h3 跳级（页面里没有 h2）。
                    换成带样式的 div，观感一致，标题层级不再断裂。 %>
                <% if (config.subtitle) { %><div class="ly-subtitle"><%= config.subtitle %></div><% } %>

            </div>
        </span>
    </div>
</div>
<div
    id="home-posts-wrap"
    ref="homePostsWrap"
    <%- theme.card.enable || 'class="home-posts-wrap-no-card"' %>
>
    <div id="home-posts">
        <%- partial("posts") %>
        <%- partial("current") %>
    </div>
    <% if (theme.card.enable) { %>
    <div id="home-card">
        <%- partial("card") %>
    </div>
    <% } %>
</div>
