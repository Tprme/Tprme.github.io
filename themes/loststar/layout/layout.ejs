<%
    let type = "post";
    if (is_home()) type = "index";
    if (is_post() || is_page()) type = "post";
    if (is_category() || page.type === "categories") type = "categories";
    if (is_tag() || page.type === "tags") type = "tags";
    if (is_archive()) type = "archives";
    let title = page.title + " | " + config.title;
    if (is_home()) title = config.title;
    if (is_post() || is_page()) {
        let displayTitle = page.title;
        const pageCatName = page.categories && page.categories.data && page.categories.data.length > 0 ? page.categories.data[0].name : null;
        if (is_post() && pageCatName === 'Diary') displayTitle = date(page.date, 'DD/MM/YYYY');
        title = displayTitle + " | " + config.title;
    }
    if (is_category()) title = "Categories: " + page.category + " | " + config.title;
    if (is_tag()) title = "Tags: " + page.tag + " | " + config.title;
    if (is_archive()) title = "Archives | " + config.title;

    /* ====== SEO: Dynamic description ====== */
    let seoDescription = config.description || '';
    if (page.description) {
        seoDescription = page.description;
    } else if (page.excerpt) {
        seoDescription = strip_html(page.excerpt).replace(/\n/g, ' ').substring(0, 200).trim();
    } else if (is_post() && page.content) {
        seoDescription = strip_html(page.content).replace(/\n/g, ' ').substring(0, 200).trim();
    }

    /* ====== SEO: Dynamic keywords ====== */
    let seoKeywords = config.keywords || '';
    if (page.keywords) {
        seoKeywords = page.keywords;
    } else if (page.tags && page.tags.length) {
        seoKeywords = page.tags.map(function(tag) { return tag.name; }).join(',');
    }

    /* ====== SEO: Dynamic image ====== */
    let seoDefaultImage = (theme.seo && theme.seo.default_image) || theme.avatar;
    let seoImage = '';
    if (page.og_image) {
        seoImage = page.og_image;
    } else if (page.photos && page.photos.length) {
        seoImage = page.photos[0];
    } else if (page.cover) {
        seoImage = page.cover;
    } else {
        seoImage = seoDefaultImage;
    }
    if (seoImage && !seoImage.startsWith('http')) {
        seoImage = config.url + url_for(seoImage);
    }
%>
<!DOCTYPE html>
<html lang="<%- config.language %>">
<head>
    <meta charset="utf-8" />
    <title><%= title %></title>
    <meta name="author" content="<%- config.author %>" />

    <meta name="keywords" content="<%- seoKeywords %>" />
    <link rel="canonical" href="<%- full_url_for(page.path || path) %>" />
    <%- open_graph({
        description: seoDescription,
        keywords: seoKeywords,
        image: seoImage,
        /* 头像是正方形，用 summary 而不是 summary_large_image，
           否则在部分平台（微信/QQ 分享卡片）会被拉伸变形 */
        twitter_card: 'summary',
        twitter_site: (theme.seo && theme.seo.twitter_site) || '',
        twitter_image: seoImage,
        fb_admins: (theme.seo && theme.seo.fb_admins) || '',
        fb_app_id: (theme.seo && theme.seo.fb_app_id) || ''
    }) %>
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <%#
      深色模式必须在 CSS 之前、且在首屏绘制之前就定好，
      否则深色用户会先看到一闪而过的白屏（FOUC）。
      所以这段用内联脚本放在 <head> 里同步执行，不能改成 defer / 外部文件。

      关键：一定要把 data-theme 写成明确的值（dark 或 light），
      不能只在深色时才设、浅色时留空 —— 留空意味着回退到
      CSS 的 prefers-color-scheme 分支，用户手动选的浅色就失效了。
      CSS 因此只需处理 [data-theme="dark"] 一种情况。
    %>
    <script>
        (function () {
            var dark;
            try {
                var saved = localStorage.getItem("ly-theme");
                dark =
                    saved === "dark" ||
                    (saved !== "light" &&
                        window.matchMedia("(prefers-color-scheme: dark)").matches);
            } catch (e) {
                /* localStorage 被禁用（隐私模式等）时退回跟随系统 */
                dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            }
            document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
            // color-scheme 让浏览器把原生滚动条、表单控件也切成对应配色
            document.documentElement.style.colorScheme = dark ? "dark" : "light";
        })();
    </script>
    <%# 移动端优化：
        theme-color 让手机浏览器的地址栏/状态栏跟随站点主色；
        format-detection 避免浏览器把页面里的数字误识别成电话号码并加上蓝色下划线 %>
    <meta name="theme-color" content="#27384c" />
    <meta name="format-detection" content="telephone=no,email=no,address=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <%# 站点图标：用真正的 .ico / .png，
        之前直接拿头像 me.jpg 当图标，部分浏览器（尤其 Safari）不认 %>
    <link rel="icon" href="<%- url_for('/favicon.ico') %>" sizes="any" />
    <link rel="icon" type="image/png" href="<%- url_for('/images/me.jpg') %>" />
    <link rel="apple-touch-icon" href="<%- url_for('/apple-touch-icon.png') %>" />
    <%- partial("import", { type }) %>
</head>
<body>
    <div id="layout">
        <transition name="fade">
            <%# 加载层。
               注意：这里绝对不能再加内联 style，
               否则会和 v-show 争夺同一个 style.display，导致 v-show 失效、
               加载层永远挡住页面（踩过这个坑）。显隐完全交给 v-show 控制。 %>
            <div id="loading" v-show="loading" aria-hidden="true">
                <div id="loading-circle">
                    <%# 这里不能用 <h2>：加载层虽然会被 v-show 隐藏，
                        但它始终留在 DOM 里，于是「加载中」会一直出现在
                        document outline 里，把标题层级从 h1 顶上多出一级。
                        改用普通 div + 样式类，视觉不变，语义干净。 %>
                    <div class="ly-loading-title"><%- (theme.i18n && theme.i18n.loading_title) || 'LOADING' %></div>
                    <p><%- (theme.i18n && theme.i18n.loading_message) || 'Please wait a moment...' %></p>
                    <img src="<%- url_for(theme.loading) %>" alt="<%- (theme.i18n && theme.i18n.loading_alt) || 'Loading' %>" />
                </div>
            </div>
        </transition>
        <%- partial("menu") %>
        <div id="main" :class="loading ? 'into-enter-from': 'into-enter-active'">
            <%- partial(type) %>
            <%- partial("footer") %>
        </div>
        <% if (theme.preview.enable) { %>
        <transition name="fade">
            <div id="preview" ref="preview" v-show="previewShow">
                <img id="preview-content" ref="previewContent" alt="<%- (theme.i18n && theme.i18n.preview_alt) || 'Image preview' %>" />
            </div>
        </transition>
        <% } %>
    </div>
    <%#
      顶部导航的液态玻璃高光跟随。
      必须放在这里而不是 import.ejs：import.ejs 在 <head> 里输出，
      那时 #menu 还没被解析出来，脚本拿不到元素就静默退出了。
    %>
    <script src="<%- url_for("/js/lib/glass.js") %>"></script>
    <script src="<%- url_for("/js/main.js") %>"></script>
    <% if (type === "post" && page.comments) { %>
    <%- partial("comment") %>
    <% } %>
</body>
</html>
