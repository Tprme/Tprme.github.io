<div id="menu">
    <nav id="desktop-menu">
        <a class="title" href="<%- config.root %>">
            <span><%= config.title.toUpperCase() %></span>
        </a>
        <% Object.entries(theme.menu).forEach(([key, value]) => { %>
        <a href="<%- url_for(value.link) %>">
            <i class="fa-<%- value.theme %> fa-<%- value.name %> fa-fw"></i>
            <span>&ensp;<%= key %></span>
        </a>
        <% }); %>
        <button id="theme-toggle" type="button" aria-label="切换深色模式" title="切换深色模式">
            <span class="ly-theme-icon" data-icon="moon" aria-hidden="true"></span>
        </button>
    </nav>
    <nav id="mobile-menu">
        <!-- 这里原来是 <div class="title" @click>：键盘用户完全打不开菜单，
             辅助技术也不会把它报成按钮。加 role/tabindex 而不是换成 <button>，
             是因为 <button> 默认是 inline-block，会把这一行的点击区域从
             「整行宽」缩成「内容宽」，手机上的可点范围反而变小。
             role="button" 不会像真按钮那样在回车/空格时触发 click，
             所以键盘事件必须自己接。 -->
        <div
            class="title"
            role="button"
            tabindex="0"
            aria-controls="mobile-menu-items"
            aria-label="导航菜单"
            :aria-expanded="showMenuItems ? 'true' : 'false'"
            @click="showMenuItems = !showMenuItems"
            @keydown.enter.prevent="showMenuItems = !showMenuItems"
            @keydown.space.prevent="showMenuItems = !showMenuItems"
        >
            <i class="fa-solid fa-bars fa-fw" aria-hidden="true"></i>
            <span>&emsp;<%= config.title.toUpperCase() %></span>
        </div>
        <transition name="slide">
            <div class="items" id="mobile-menu-items" v-show="showMenuItems">
                <% Object.entries(theme.menu).forEach(([key, value]) => { %>
                <a href="<%- url_for(value.link) %>">
                    <div class="item">
                        <div style="min-width: 20px; max-width: 50px; width: 10%">
                            <i class="fa-<%- value.theme %> fa-<%- value.name %> fa-fw"></i>
                        </div>
                        <div style="min-width: 100px; max-width: 150%; width: 20%"><%= key %></div>
                    </div>
                </a>
                <% }); %>
                <button id="theme-toggle-mobile" type="button" aria-label="切换深色模式">
                    <div class="item">
                        <div style="min-width: 20px; max-width: 50px; width: 10%">
                            <span class="ly-theme-icon" data-icon="moon" aria-hidden="true"></span>
                        </div>
                        <div style="min-width: 100px; max-width: 150%; width: 20%">深色模式</div>
                    </div>
                </button>
            </div>
        </transition>
    </nav>
</div>
<transition name="fade">
    <div id="menu-curtain" @click="showMenuItems = !showMenuItems" v-show="showMenuItems"></div>
</transition>
