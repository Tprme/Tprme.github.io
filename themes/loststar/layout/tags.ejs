<div id="archives">
    <% let posts = []; %>
    <%
        const getDisplayTitle = (post) => {
            const catName = post.categories && post.categories.data.length > 0 ? post.categories.data[0].name : null;
            return catName === 'Diary' ? date(post.date, 'DD/MM/YYYY') : post.title;
        };
    %>
    <%- partial("_partial/page-heading") %>
    <div class="categories-tags">
        <% site.tags.forEach((tag) => { %>
        <%
            const tagStyle = getTxTagStyle(tag.name);
            const isActive = is_tag(tag.name);
            /* 深浅两套配色都写进 CSS 变量，由 custom.css 按主题选一套。
               为什么不能再像以前那样直接内联 background/color：
               内联样式不会跟着 [data-theme] 变，所以深色模式下胶囊
               会一直保持浅色模式的浅底深字，在深色页面里就是一块块亮斑。
               深色那套由 helper 按色相自动推导（见 taxonomy-style-helper.js）。 */
            const chipBase = tagStyle ? tagStyle.bg : '#eef2f7';
            const chipDark = tagStyle ? tagStyle.dBg : '#26313d';
            const chipBg = isActive ? `linear-gradient(120deg, ${chipBase} 0%, ${chipBase} 60%)` : chipBase;
            const chipBgDark = isActive ? `linear-gradient(120deg, ${chipDark} 0%, ${chipDark} 60%)` : chipDark;
            const chipText = tagStyle ? tagStyle.text : '#4f6370';
            const chipTextDark = tagStyle ? tagStyle.dText : '#b6c2d0';
        %>
        <span>
            <a href="<%- url_for(tag.path) %>" class="tx-chip<% if (isActive) { %> active-chip<% } %>" style="--tx-bg: <%- chipBg %>; --tx-fg: <%- chipText %>; --tx-dbg: <%- chipBgDark %>; --tx-dfg: <%- chipTextDark %>">
                <span class="icon">
                    <i class="fa-solid fa-tags fa-fw"></i>
                </span>
                <%= tag.name %>
            </a>
        </span>
        <% if (isActive) { %>
        <%
            posts = tag.posts;
            posts.data.sort((a, b) => b.date - a.date);
        %>
        <% } %>
        <% }); %>
    </div>
    <% posts.forEach((post) => { %>
    <%
        const postCatName = post.categories && post.categories.data.length > 0 ? post.categories.data[0].name : null;
    %>
    <div class="timeline">
        <div class="timeline-tail"></div>
        <div class="timeline-content">
            <div class="item-time"><%= date(post.date, "YYYY/M/D") %></div>
            <a href="<%- url_for(post.path) %>">
                <%# 原来是 h3，与页面标题 h1 之间缺一级。改 h2，字号见 custom.css %>
                <h2><%= getDisplayTitle(post) %></h2>
            </a>
            <div class="info">
                <% if (post.categories && post.categories.data.length !== 0) { %>
                <%
                    const catStyle = getTxCategoryStyle(post.categories.data[0].name);
                %>
                <span class="category">
                    <a href="<%- url_for(post.categories.data[0].path) %>"<% if (catStyle) { %> style="color:<%- catStyle.text %>"<% } %>>
                        <span class="icon">
                            <i class="fa-solid fa-bookmark fa-fw"></i>
                        </span>
                        <%= post.categories.data[0].name %>
                    </a>
                </span>
                <% } %>
                <% if (post.tags && post.tags.data.length !== 0) { %>
                <span class="tags">
                    <span class="icon">
                        <i class="fa-solid fa-tags fa-fw"></i>
                    </span>
                    <% post.tags.data.forEach((tag) => { %>
                    <%
                        const tStyle = getTxTagStyle(tag.name, postCatName);
                    %>
                    <span class="tag">
                        <a href="<%- url_for(tag.path) %>"<% if (tStyle) { %> style="color:<%- tStyle.text %>"<% } %>>
                            <%= tag.name %>
                        </a>
                    </span>
                    <% }); %>
                </span>
                <% } %>
            </div>
        </div>
    </div>
    <% }); %>
</div>
