<header id="menu" class="site-header">
    <div class="header-inner">
        <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页"><span class="brand-mark" aria-hidden="true">t.</span><span><%= config.title %></span></a>
        <nav id="desktop-menu" aria-label="主导航">
            <% Object.entries(theme.menu).forEach(([label, href]) => {
                const selected = href === '/' ? is_home() : ('/' + (page.path || '')).startsWith(href.replace(/\/$/, ''));
            %>
            <a href="<%- url_for(href) %>" data-nav-preview="<%= label %>"<% if (selected) { %> aria-current="page"<% } %>><%= label %><svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="m2 4 3 3 3-3" stroke="currentColor" stroke-width="1.2"/></svg></a>
            <% }); %>
        </nav>
        <div class="header-tools">
            <a class="archive-shortcut" href="<%- url_for('/archives/#search') %>" aria-label="搜索文章"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></a>
            <button id="theme-toggle" class="icon-button" type="button" aria-label="切换深浅主题" title="切换深浅主题"><svg class="theme-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 14a8.5 8.5 0 0 1-10-10A8.5 8.5 0 1 0 20 14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><svg class="theme-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
            <details id="mobile-menu">
                <summary aria-label="展开导航菜单"><span></span><span></span></summary>
                <nav aria-label="手机导航"><% Object.entries(theme.menu).forEach(([label, href]) => { %><a href="<%- url_for(href) %>"><%= label %><span aria-hidden="true">↗</span></a><% }); %></nav>
            </details>
        </div>
    </div>
</header>
