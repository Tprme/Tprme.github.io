<% const navPosts = site.posts.toArray().filter(post => post.published !== false).sort((a, b) => b.date - a.date);
   const navMonths = [...new Set(navPosts.map(post => date(post.date, 'YYYY/MM'))) ].slice(0, 5);
   const navCategories = site.categories.toArray().sort((a, b) => b.length - a.length);
   const navTags = site.tags.toArray().sort((a, b) => b.length - a.length || a.name.localeCompare(b.name, 'zh')).slice(0, 10);
%>
<nav id="nav-preview" aria-label="导航快捷入口" hidden>
    <section class="nav-preview-panel" data-nav-panel="归档" data-width="300" id="nav-preview-archives" aria-label="按月归档" hidden inert>
        <% navMonths.forEach(month => { %>
        <a class="nav-preview-row" href="<%- url_for('/archives/') %>#month-<%= month.replace('/', '-') %>"><span><%= month.replace('/', ' / ') %></span><small><%= navPosts.filter(post => date(post.date, 'YYYY/MM') === month).length %> 篇</small></a>
        <% }); %>
        <a class="nav-preview-footer" href="<%- url_for('/archives/') %>">全部归档 <span aria-hidden="true">↗</span></a>
    </section>
    <section class="nav-preview-panel" data-nav-panel="分类" data-width="280" id="nav-preview-categories" aria-label="文章分类" hidden inert>
        <% navCategories.forEach(category => { %>
        <a class="nav-preview-row" href="<%- url_for(category.path) %>"><span><%= category.name %></span><small><%= category.length %> 篇</small></a>
        <% }); %>
        <a class="nav-preview-footer" href="<%- url_for('/categories/') %>">全部分类 <span aria-hidden="true">↗</span></a>
    </section>
    <section class="nav-preview-panel" data-nav-panel="标签" data-width="360" id="nav-preview-tags" aria-label="常用标签" hidden inert>
        <div class="nav-preview-tags">
            <% navTags.forEach(tag => { %>
            <a href="<%- url_for(tag.path) %>"><%= tag.name %><small><%= tag.length %></small></a>
            <% }); %>
        </div>
        <a class="nav-preview-footer" href="<%- url_for('/tags/') %>">全部标签 <span aria-hidden="true">↗</span></a>
    </section>
</nav>
