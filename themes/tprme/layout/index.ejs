<% const firstPage = !page.current || page.current === 1; %>
<div class="shell">
    <% if (firstPage) { %>
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
            <h1 id="hero-title"><%= config.title %><span class="title-dot">.</span></h1>
            <p class="hero-subtitle"><%= config.subtitle %></p>
            <div class="hero-actions"><a class="button button-primary" href="#latest">读最近的文章 <span aria-hidden="true">↓</span></a><a class="button button-secondary" href="<%- url_for('/about/') %>">关于我 <span aria-hidden="true">↗</span></a></div>
        </div>
        <figure class="hero-figure">
            <button type="button" class="hero-photo" data-photo="<%- url_for(theme.hero) %>" aria-label="放大首页照片"><img src="<%- url_for(theme.hero) %>" alt="路牌旁的摩托车合影" width="509" height="660" fetchpriority="high"><span class="photo-expand" aria-hidden="true">↗</span></button>
        </figure>
    </section>
    <% } %>
    <section class="latest<%= firstPage ? '' : ' paged-list' %>" id="latest" aria-labelledby="latest-title">
        <div class="section-head"><% if (firstPage) { %><h2 id="latest-title">文章</h2><% } else { %><h1 id="latest-title">继续翻阅</h1><% } %><a class="button button-secondary" href="<%- url_for('/archives/') %>">全部 <%= site.posts.length %> 篇 <span aria-hidden="true">↗</span></a></div>
        <div class="home-columns"><div class="post-list"><% page.posts.forEach(post => { %><%- partial('_partial/post-card', { post }) %><% }); %><%- partial('_partial/pagination') %></div>
        <aside class="home-aside" aria-label="按分类阅读"><span class="eyebrow">按分类阅读</span><% site.categories.toArray().sort((a,b) => b.length-a.length).forEach(category => { %><a class="category-shortcut" href="<%- url_for(category.path) %>"><span><%= category.name %></span><small><%= category.length %> 篇 ↗</small></a><% }); %><div class="aside-note"><p>通过 RSS 阅读更新。</p><a class="button button-secondary" href="<%- url_for('/subscribe/') %>">订阅文章 <span aria-hidden="true">↗</span></a></div></aside></div>
    </section>
</div>
