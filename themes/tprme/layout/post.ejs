<% const isArticle = is_post(); const isAbout = /^about\/(?:index\.html)?$/.test(page.path || ''); const headings = !page.secret ? toc(page.content, {class:'toc', list_number:false}) : ''; %>
<% if (isArticle) { %><div class="reading-progress" aria-hidden="true"><span></span></div><% } %>
<div class="shell article-layout<%= page.nofollow ? ' not-found-page' : '' %>">
    <article class="article">
        <header class="article-heading"><a class="button button-secondary back-link" href="<%- url_for('/') %>"><span aria-hidden="true">←</span> 返回首页</a>
            <% if (isArticle) { %><div class="post-meta"><time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY.MM.DD') %></time><span class="meta-separator">/</span><% page.categories.forEach(category => { %><a href="<%- url_for(category.path) %>"><%= category.name %></a><% }); %><span class="meta-separator">/</span><span>约 <%= Math.max(1, Math.ceil(strip_html(page.content).length/450)) %> 分钟</span></div><% } %>
            <div class="article-title-row"><h1><%= page.title %></h1><% if (isAbout && theme.avatar) { %><button type="button" class="about-avatar" data-photo="<%- url_for(theme.avatar) %>" aria-label="查看 <%= config.author %> 的头像"><img src="<%- url_for(theme.avatar) %>" alt="<%= config.author %> 的头像" width="88" height="88"></button><% } %></div>
            <% if (isArticle) { %><div class="post-tags"><% page.tags.forEach(tag => { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div><% } %>
        </header>
        <% if (page.secret) { throw new Error('加密文章需要先接入解密组件，停止构建以免公开正文。'); } %>
        <% if (headings && !page.nofollow) { %><details class="mobile-toc"><summary>文章目录</summary><nav aria-label="文章目录"><%- headings %></nav></details><% } %>
        <div class="prose"><%- page.content %></div>
        <% if (isArticle) { %><footer class="article-bottom"><span>写于 <%= date(page.date, 'YYYY 年 M 月 D 日') %></span><a href="#main">回到顶部 ↑</a></footer><nav class="post-neighbors" aria-label="相邻文章"><% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>"><small>← 较新的文章</small><span><%= page.prev.title %></span></a><% } %><% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><small>较早的文章 →</small><span><%= page.next.title %></span></a><% } %></nav><% } %>
    </article>
    <% if (headings && !page.nofollow) { %><aside class="desktop-toc"><nav aria-label="文章目录"><span class="eyebrow">本页目录</span><%- headings %></nav><a class="toc-top" href="#main">回到顶部 ↑</a></aside><% } %>
</div>
