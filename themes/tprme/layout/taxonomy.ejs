<% const categoryPage = is_category() || page.type === 'categories';
   const collection = (categoryPage ? site.categories : site.tags).toArray().sort((a,b) => b.length-a.length || a.name.localeCompare(b.name, 'zh'));
   const selected = categoryPage ? page.category : page.tag;
   const label = categoryPage ? '分类' : '标签';
%>
<div class="shell collection-page">
    <header class="page-heading"><h1><%= selected || label %><span class="heading-count"><%= selected ? collection.find(item => item.name === selected).length : collection.length %></span></h1></header>
    <nav class="taxonomy-cloud" aria-label="<%= label %>"><% if (selected) { %><a href="<%- url_for(categoryPage ? '/categories/' : '/tags/') %>">全部</a><% } %><% collection.forEach(item => { %><a href="<%- url_for(item.path) %>"<% if (selected === item.name) { %> aria-current="page"<% } %>><%= item.name %><small><%= item.length %></small></a><% }); %></nav>
    <% if (selected) { %><section class="taxonomy-posts" aria-label="<%= selected %>的文章"><h2 class="visually-hidden">文章列表</h2><% page.posts.forEach(post => { %><%- partial('_partial/post-card', {post}) %><% }); %><%- partial('_partial/pagination') %></section>
    <% } %>
</div>
